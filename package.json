{
  "name": "bandersnatch-m1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "serve": "python3 -m http.server 4173 --bind 127.0.0.1",
    "serve:fixture": "python3 -m http.server 4176 --bind 127.0.0.1 --directory fixtures",
    "serve:review": "node src/review-server.mjs",
    "m1:demo": "node src/run-golden-path.mjs --mock",
    "m1:live": "node src/run-golden-path.mjs --live",
    "test": "node --test tests/core.test.mjs tests/review-server.test.mjs tests/accessibility.test.mjs tests/joined-accessibility.test.mjs",
    "test:web": "node --test tests/playwright-web.test.mjs tests/playwright-accessibility.test.mjs",
    "test:android-accessibility": "node --test tests/android-accessibility.test.mjs",
    "a4:demo": "node src/run-accessibility-demo.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "playwright": "1.61.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
